pipeline {
    agent any

    parameters {
        string(name: 'DOCKER_USERNAME', defaultValue: '', description: 'DockerHub username')
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Docker image tag to deploy (latest, commit-sha, build-number)')
        string(name: 'CONTAINER_PORT', defaultValue: '8000', description: 'Container port')
        string(name: 'HOST_PORT', defaultValue: '8000', description: 'Host port to map')
        booleanParam(name: 'RUN_TESTS', defaultValue: true, description: 'Run functional tests')
        booleanParam(name: 'CLEANUP_AFTER', defaultValue: true, description: 'Stop and remove container after tests')
    }

    environment {
        DOCKERHUB_CREDS = credentials('docker-hub')
        DOCKER_IMAGE_NAME = 'imagenet-classifier'
        DOCKER_REGISTRY = 'docker.io'
        CONTAINER_NAME = 'imagenet-classifier'
        LC_ALL = "en_US.UTF-8"
        LANG = "en_US.UTF-8"
        LANGUAGE = "en_US.UTF-8"
        TEST_RESULTS_DIR = "${WORKSPACE}/test-results"
    }

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    triggers {
        // Расписание: каждый день в 2:00 UTC для автоматического тестирования latest image
        cron('0 2 * * *')
        
        // Pipeline job trigger с CI pipeline (вызывается из последнего stage CI)
        upstream(upstreamProjects: 'imagenet-classifier-build', threshold: hudson.model.Result.SUCCESS)
    }

    stages {
        stage('Pre-flight Check') {
            steps {
                echo "══════════════════════════════════════════"
                echo "CD Pipeline - Functional Testing"
                echo "══════════════════════════════════════════"
                echo "Image: ${DOCKERHUB_CREDS_USR}/${DOCKER_IMAGE_NAME}:${params.IMAGE_TAG}"
                echo "Container Port: ${params.CONTAINER_PORT}"
                echo "Host Port: ${params.HOST_PORT}"
                echo "Run Tests: ${params.RUN_TESTS}"
                echo "══════════════════════════════════════════"
                
                // Создаем директорию для результатов тестов
                sh '''
                    mkdir -p "${TEST_RESULTS_DIR}"
                    echo "Test results directory created: ${TEST_RESULTS_DIR}"
                '''
                
                // Проверяем Docker доступен
                sh 'docker --version'
                sh 'docker compose version'
            }
        }

        stage('Login to DockerHub') {
            steps {
                echo "🔐 Logging in to DockerHub..."
                sh '''
                    echo ${DOCKERHUB_CREDS_PSW} | docker login -u ${DOCKERHUB_CREDS_USR} --password-stdin
                    echo "✓ Successfully logged in"
                '''
            }
        }

        stage('Pull Image') {
            steps {
                echo "📥 Pulling Docker image..."
                sh '''
                    echo "Pulling: ${DOCKERHUB_CREDS_USR}/${DOCKER_IMAGE_NAME}:${IMAGE_TAG}"
                    docker pull ${DOCKERHUB_CREDS_USR}/${DOCKER_IMAGE_NAME}:${IMAGE_TAG}
                    echo "✓ Image pulled successfully"
                    
                    # Проверяем что image существует
                    docker inspect ${DOCKERHUB_CREDS_USR}/${DOCKER_IMAGE_NAME}:${IMAGE_TAG} > ${TEST_RESULTS_DIR}/image-info.txt
                '''
            }
        }

        stage('Stop Previous Container') {
            steps {
                echo "🛑 Preparing Docker Compose environment..."
                sh '''
                    set +x
                    cat > .cd.env <<EOF
DB_USER=ci_user
DB_PASSWORD=ci-${BUILD_NUMBER}
DB_NAME=ci_predictions
VAULT_TOKEN=vault-${BUILD_NUMBER}
USE_VAULT=true
HOST_PORT=${HOST_PORT}
MODEL_IMAGE=${DOCKERHUB_CREDS_USR}/${DOCKER_IMAGE_NAME}:${IMAGE_TAG}
EOF
                    docker compose --env-file .cd.env down -v --remove-orphans || true
                    echo "✓ Compose environment prepared"
                '''
            }
        }

        stage('Start Container') {
            steps {
                echo "🚀 Starting Vault, PostgreSQL and model API..."
                sh '''
                    docker compose --env-file .cd.env up -d --no-build
                    CONTAINER_ID=$(docker ps -q -f name=${CONTAINER_NAME})
                    echo "Container ID: $CONTAINER_ID"
                    echo "$CONTAINER_ID" > ${TEST_RESULTS_DIR}/container-id.txt
                    docker compose --env-file .cd.env ps
                '''
            }
        }

        stage('Container Logs') {
            steps {
                echo "📋 Displaying container startup logs..."
                sh '''
                    echo "=== Container Logs (first 50 lines) ==="
                    docker compose --env-file .cd.env logs --no-color | head -100 | tee ${TEST_RESULTS_DIR}/startup-logs.txt
                    docker compose --env-file .cd.env logs --no-color model-api | grep 'Учетные данные БД получены из Vault'
                    echo "=== End of logs ==="
                '''
            }
        }

        stage('Health Check') {
            steps {
                echo "❤️  Performing health check..."
                script {
                    sh '''
                        echo "Waiting for API to be ready..."
                        MAX_RETRIES=10
                        RETRY=0
                        
                        while [ $RETRY -lt $MAX_RETRIES ]; do
                            if docker exec ${CONTAINER_NAME} curl -s -f http://localhost:${CONTAINER_PORT}/health > /dev/null 2>&1; then
                                echo "✓ Health check passed"
                                exit 0
                            fi
                            RETRY=$((RETRY + 1))
                            echo "  Attempt $RETRY/$MAX_RETRIES..."
                            sleep 2
                        done
                        
                        echo "✗ Health check failed after $MAX_RETRIES attempts"
                        exit 1
                    '''
                }
            }
        }

        stage('API Tests') {
            when {
                expression { params.RUN_TESTS == true }
            }
            steps {
                echo "🧪 Running API endpoint tests..."
                sh '''
                    TEST_LOG="${TEST_RESULTS_DIR}/api-tests.txt"
                    > "$TEST_LOG"  # Clear file
                    
                    echo "Testing API endpoints..." | tee -a "$TEST_LOG"
                    
                    # Test 1: Health endpoint
                    echo "" | tee -a "$TEST_LOG"
                    echo "TEST 1: GET /health" | tee -a "$TEST_LOG"
                    echo "─────────────────────" | tee -a "$TEST_LOG"
                    RESPONSE=$(docker exec ${CONTAINER_NAME} curl -s -w "\\nHTTP_CODE:%{http_code}" http://localhost:${CONTAINER_PORT}/health)
                    HTTP_CODE=$(echo "$RESPONSE" | grep HTTP_CODE | cut -d: -f2)
                    
                    if [ "$HTTP_CODE" = "200" ]; then
                        echo "✓ Status: 200 OK" | tee -a "$TEST_LOG"
                        echo "$RESPONSE" | head -1 | tee -a "$TEST_LOG"
                    else
                        echo "✗ Status: $HTTP_CODE (Expected 200)" | tee -a "$TEST_LOG"
                        exit 1
                    fi
                    
                    # Test 2: Info endpoint
                    echo "" | tee -a "$TEST_LOG"
                    echo "TEST 2: GET /info" | tee -a "$TEST_LOG"
                    echo "─────────────────────" | tee -a "$TEST_LOG"
                    RESPONSE=$(docker exec ${CONTAINER_NAME} curl -s -w "\\nHTTP_CODE:%{http_code}" http://localhost:${CONTAINER_PORT}/info)
                    HTTP_CODE=$(echo "$RESPONSE" | grep HTTP_CODE | cut -d: -f2)
                    
                    if [ "$HTTP_CODE" = "200" ]; then
                        echo "✓ Status: 200 OK" | tee -a "$TEST_LOG"
                        echo "$RESPONSE" | head -5 | tee -a "$TEST_LOG"
                    else
                        echo "✗ Status: $HTTP_CODE (Expected 200)" | tee -a "$TEST_LOG"
                        exit 1
                    fi
                    
                    # Test 3: POST /predict endpoint
                    echo "" | tee -a "$TEST_LOG"
                    echo "TEST 3: POST /predict" | tee -a "$TEST_LOG"
                    echo "─────────────────────" | tee -a "$TEST_LOG"
                    
                    # Generate random pixel data (2352 floats)
                    PAYLOAD=$(python3 << 'PYTHON'
import json
import random
pixels = [random.random() for _ in range(2352)]
print(json.dumps({"pixels": pixels}))
PYTHON
)
                    
                    RESPONSE=$(printf '%s' "$PAYLOAD" | docker exec -i ${CONTAINER_NAME} curl -s -w "\\nHTTP_CODE:%{http_code}" \
                        -X POST http://localhost:${CONTAINER_PORT}/predict \
                        -H "Content-Type: application/json" \
                        -d @-)
                    HTTP_CODE=$(echo "$RESPONSE" | grep HTTP_CODE | cut -d: -f2)
                    
                    if [ "$HTTP_CODE" = "200" ]; then
                        echo "✓ Status: 200 OK" | tee -a "$TEST_LOG"
                        echo "$RESPONSE" | head -5 | tee -a "$TEST_LOG"
                    else
                        echo "✗ Status: $HTTP_CODE (Expected 200)" | tee -a "$TEST_LOG"
                        exit 1
                    fi
                    
                    echo "" | tee -a "$TEST_LOG"
                    echo "All API tests passed ✓" | tee -a "$TEST_LOG"
                '''
            }
        }

        stage('Performance Metrics') {
            when {
                expression { params.RUN_TESTS == true }
            }
            steps {
                echo "⚡ Collecting performance metrics..."
                sh '''
                    METRICS_LOG="${TEST_RESULTS_DIR}/performance.txt"
                    > "$METRICS_LOG"
                    
                    echo "=== Container Performance Metrics ===" | tee -a "$METRICS_LOG"
                    echo "Timestamp: $(date -u +'%Y-%m-%dT%H:%M:%SZ')" | tee -a "$METRICS_LOG"
                    echo "" | tee -a "$METRICS_LOG"
                    
                    # Docker inspect for resource info
                    echo "Container Details:" | tee -a "$METRICS_LOG"
                    docker inspect ${CONTAINER_NAME} | grep -E '"Id"|"State"|"Image"' | tee -a "$METRICS_LOG"
                    
                    echo "" | tee -a "$METRICS_LOG"
                    echo "Container Stats:" | tee -a "$METRICS_LOG"
                    docker stats ${CONTAINER_NAME} --no-stream | tee -a "$METRICS_LOG"
                    
                    echo "" | tee -a "$METRICS_LOG"
                    echo "Response Time Test:" | tee -a "$METRICS_LOG"
                    
                    for i in 1 2 3; do
                        TIME=$(docker exec ${CONTAINER_NAME} curl -s -o /dev/null -w '%{time_total}' http://localhost:${CONTAINER_PORT}/health)
                        echo "  Request $i: ${TIME}s" | tee -a "$METRICS_LOG"
                    done
                '''
            }
        }

        stage('Docker Logs Capture') {
            steps {
                echo "📝 Capturing full container logs..."
                sh '''
                    LOGS_FILE="${TEST_RESULTS_DIR}/container-logs.txt"
                    docker compose --env-file .cd.env logs --no-color > "$LOGS_FILE" 2>&1
                    echo "Logs saved to: $LOGS_FILE"
                    
                    # Show last 20 lines
                    echo "=== Last 20 lines of logs ==="
                    tail -20 "$LOGS_FILE"
                '''
            }
        }

        stage('Generate Test Report') {
            steps {
                echo "📊 Generating test report..."
                sh '''
                    REPORT="${TEST_RESULTS_DIR}/test-report.txt"
                    
                    cat > "$REPORT" <<'REPORT_END'
═══════════════════════════════════════════════════════════════
                    CD PIPELINE TEST REPORT
═══════════════════════════════════════════════════════════════
REPORT_END
                    
                    echo "Build Information:" >> "$REPORT"
                    echo "  Build Number: ${BUILD_NUMBER}" >> "$REPORT"
                    echo "  Build URL: ${BUILD_URL}" >> "$REPORT"
                    echo "  Timestamp: $(date -u +'%Y-%m-%dT%H:%M:%SZ')" >> "$REPORT"
                    echo "" >> "$REPORT"
                    
                    echo "Deployment Configuration:" >> "$REPORT"
                    echo "  Image: ${DOCKERHUB_CREDS_USR}/${DOCKER_IMAGE_NAME}:${IMAGE_TAG}" >> "$REPORT"
                    echo "  Container Name: ${CONTAINER_NAME}" >> "$REPORT"
                    echo "  Port Mapping: ${HOST_PORT}:${CONTAINER_PORT}" >> "$REPORT"
                    echo "  Container ID: $(cat ${TEST_RESULTS_DIR}/container-id.txt 2>/dev/null || echo 'N/A')" >> "$REPORT"
                    echo "" >> "$REPORT"
                    
                    echo "Test Results:" >> "$REPORT"
                    echo "  Health Check: ✓ PASSED" >> "$REPORT"
                    
                    if [ -f "${TEST_RESULTS_DIR}/api-tests.txt" ]; then
                        echo "  API Tests: ✓ PASSED" >> "$REPORT"
                    else
                        echo "  API Tests: ⊘ SKIPPED" >> "$REPORT"
                    fi
                    
                    echo "" >> "$REPORT"
                    echo "Test Files:" >> "$REPORT"
                    ls -lah "${TEST_RESULTS_DIR}/"  >> "$REPORT"
                    
                    echo "" >> "$REPORT"
                    echo "═══════════════════════════════════════════════════════════════" >> "$REPORT"
                    
                    cat "$REPORT"
                '''
            }
        }
    }

    post {
        success {
            echo '''
            ╔════════════════════════════════════════════════╗
            ║  ✅ CD Pipeline Test Completed Successfully!   ║
            ║                                                ║
            ║  Container Status: RUNNING ✓                  ║
            ║  All Tests: PASSED ✓                          ║
            ╚════════════════════════════════════════════════╝
            '''
            
            // Archive test results
            archiveArtifacts artifacts: 'test-results/**', allowEmptyArchive: true
        }

        failure {
            echo '''
            ╔════════════════════════════════════════════════╗
            ║  ❌ CD Pipeline Failed!                         ║
            ║                                                ║
            ║  Check console output for details              ║
            ║  Build URL: ${BUILD_URL}                       ║
            ╚════════════════════════════════════════════════╝
            '''
            
            // Capture logs even on failure
            sh '''
                docker logs ${CONTAINER_NAME} > ${TEST_RESULTS_DIR}/failure-logs.txt 2>&1 || true
                docker ps -a >> ${TEST_RESULTS_DIR}/docker-ps.txt 2>&1 || true
            '''
            
            archiveArtifacts artifacts: 'test-results/**', allowEmptyArchive: true
        }

        always {
            echo "🧹 Cleanup stage..."
            script {
                if (params.CLEANUP_AFTER) {
                    sh '''
                        echo "Stopping and removing container..."
                        docker compose --env-file .cd.env down -v --remove-orphans || true
                        rm -f .cd.env
                        
                        echo "Logging out from Docker..."
                        docker logout || true
                        
                        echo "✓ Cleanup completed"
                    '''
                } else {
                    sh '''
                        echo "Container will remain running for inspection"
                        docker compose --env-file .cd.env ps
                        
                        docker logout || true
                    '''
                }
            }
            
            // Clean workspace if needed
            cleanWs(patterns: [[pattern: 'test-results/**', type: 'INCLUDE']], deleteDirs: false)
        }
    }
}
