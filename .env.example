# Примечание: Все секреты (пароли БД, токены) хранятся в HashiCorp Vault
# Этот файл содержит только непроизводственные параметры конфигурации

# Конфигурация для Vault (раскомментируйте и установите при необходимости)
# VAULT_ADDR=http://vault:8200
# VAULT_TOKEN=<your_vault_token>
# USE_VAULT=true

# Переменные БД нужны только для инициализации Vault
# Они не используются приложением при включенном Vault
# (Закомментированы для безопасности)
# DB_USER=<set_via_vault>
# DB_PASSWORD=<set_via_vault>
# DB_NAME=<set_via_vault>
# DB_HOST=postgres
# DB_PORT=5432
